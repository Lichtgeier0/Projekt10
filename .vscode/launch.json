{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Expense Manager",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/src/main.py",
      "console": "integratedTerminal",
      "env": {
        "EXPENSE_DB": "${workspaceFolder}/data/processed/expenses.sqlite"
      }
    },
    {
      "name": "Run Flask UI",
      "type": "python",
      "request": "launch",
      "module": "flask",
      "console": "integratedTerminal",
      "env": {
        "FLASK_APP": "src.ui.webapp",
        "FLASK_ENV": "development",
        "EXPENSE_DB": "${workspaceFolder}/data/processed/expenses.sqlite"
      },
      "args": [
        "run",
        "--debug"
      ]
    }
  ]
}
